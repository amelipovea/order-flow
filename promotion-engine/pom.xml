<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ec.udla.orderflow</groupId>
        <artifactId>orderflow-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>promotion-engine</artifactId>
    <packaging>bundle</packaging>

    <name>OrderFlow - Promotion Engine</name>

    <dependencies>

        <dependency>
            <groupId>ec.udla.orderflow</groupId>
            <artifactId>order-service</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>

                <configuration>
                    <instructions>

                        <Bundle-SymbolicName>
                            promotion-engine
                        </Bundle-SymbolicName>

                        <Export-Package>!*</Export-Package>

                        <Private-Package>
                            ec.udla.orderflow.promotions.*
                        </Private-Package>

                        <Import-Package>
                            ec.udla.orderflow.orders.api;version="[1.0,2)",
                            *
                        </Import-Package>

                        <_dsannotations>*</_dsannotations>

                    </instructions>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>